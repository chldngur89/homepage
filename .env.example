# Formspree (선택): https://formspree.io 에서 폼 생성 후 Form ID 입력
# 입력 시 문의가 Formspree를 거쳐 이메일(chldngur89@naver.com 등)로 전달됩니다.
# 비워두면 문의하기 제출 시 사용자 메일 앱이 열리고, 수신 주소는 site.json의 contactEmail(chldngur89@naver.com)입니다.
VITE_FORMSPREE_FORM_ID=

# (선택) Google Analytics 4 측정 ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 운영 도메인. 미설정 시 https://homepage-roan-kappa.vercel.app (현재 배포 주소) 를 사용한다.
# 커스텀 도메인이 붙으면 여기와 ssg/site.ts 의 FALLBACK_SITE_URL 을 함께 옮긴다.
# canonical, hreflang, sitemap, OG, JSON-LD 가 모두 이 값을 따른다.
VITE_SITE_URL=
